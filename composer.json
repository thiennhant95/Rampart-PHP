{
    "name": "rampart/php",
    "description": "Standalone PHP 7.4+ quality gate for plain PHP and any framework (Slim, CodeIgniter 4, FuelPHP, Symfony, Phalcon): wraps phpcs, phpstan, phpunit, composer audit and adds custom PHP-Parser security analyzers.",
    "keywords": ["php", "php74", "quality", "security", "static-analysis", "phpcs", "phpstan", "phpunit", "slim", "codeigniter", "fuelphp", "symfony", "phalcon", "ci"],
    "license": "MIT",
    "type": "library",
    "homepage": "https://github.com/thiennhant95/Rampart-PHP",
    "support": {
        "issues": "https://github.com/thiennhant95/Rampart-PHP/issues",
        "source": "https://github.com/thiennhant95/Rampart-PHP",
        "docs": "https://thiennhant95.github.io/Rampart-PHP/"
    },
    "bin": [
        "bin/rampart"
    ],
    "require": {
        "php": ">=7.4",
        "nikic/php-parser": "^5.0",
        "symfony/console": "^5.4",
        "symfony/process": "^5.4",
        "symfony/polyfill-php80": "^1.27"
    },
    "require-dev": {
        "phpstan/phpstan": "1.12.34",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs --standard=phpcs.xml.dist src tests tools config",
        "analyse": "phpstan analyse --memory-limit=1G --no-progress",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ],
        "smoke": "php tools/smoke-install.php"
    },
    "autoload": {
        "psr-4": {
            "Rampart\\Php\\": "src/"
        },
        "files": [
            "src/bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Rampart\\Php\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "7.4.33"
        }
    },
    "minimum-stability": "stable"
}

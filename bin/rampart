#!/usr/bin/env php
<?php

declare(strict_types=1);

// The canonical AST cache plus the optional taint engine can exceed PHP's
// default 128M on a few hundred files. Raise the CLI floor; an explicit
// php.ini limit above 512M is left untouched.
$memoryLimit = (string) ini_get('memory_limit');
$toBytes = static function (string $value): int {
    $value = trim($value);
    if ($value === '' || $value === '-1') {
        return -1;
    }
    $unit = strtolower(substr($value, -1));
    $number = (int) $value;
    if ($unit === 'g') {
        return $number * 1024 * 1024 * 1024;
    }
    if ($unit === 'm') {
        return $number * 1024 * 1024;
    }
    if ($unit === 'k') {
        return $number * 1024;
    }

    return $number;
};
$currentMemory = $toBytes($memoryLimit);
if ($currentMemory !== -1 && $currentMemory < 512 * 1024 * 1024) {
    @ini_set('memory_limit', '512M');
}

// Standalone scan: no composer install in the target project needed.
// Usage: php bin/rampart <target-dir> [--format=all] [options]

/**
 * Locate the Composer autoloader.
 *
 * The tool runs from two layouts:
 *  - a clone of this repository: `<root>/vendor/autoload.php`
 *  - installed as a dependency: `<project>/vendor/autoload.php`
 *
 * @return string|null
 */
$locateAutoloader = static function (): ?string {
    $candidates = [];
    $directory = __DIR__;
    for ($depth = 0; $depth < 6; $depth++) {
        $candidates[] = $directory . '/vendor/autoload.php';
        $candidates[] = $directory . '/autoload.php';
        $parent = dirname($directory);
        if ($parent === $directory) {
            break;
        }
        $directory = $parent;
    }

    foreach ($candidates as $candidate) {
        if (is_file($candidate)) {
            return $candidate;
        }
    }

    return null;
};

$autoload = $locateAutoloader();
if ($autoload === null) {
    fwrite(STDERR, "Could not locate a Composer autoloader. Run 'composer install' first.\n");
    exit(2);
}
require $autoload;

use Rampart\Php\Standalone\StandaloneRunner;
use Symfony\Component\Console\Output\StreamOutput;

$argv = $_SERVER['argv'] ?? [];
array_shift($argv);

$output = new StreamOutput(fopen('php://stdout', 'w'));
exit((new StandaloneRunner($argv))->run($output, dirname(__DIR__)));
